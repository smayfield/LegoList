@page "/lists/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@using LegoList.Blazor.Models

<PageTitle>@(list?.Name ?? "List")</PageTitle>

@if (list is null && errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (list is null)
{
    <p>Loading...</p>
}
else
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Lists</a></li>
            <li class="breadcrumb-item active">@list.Name</li>
        </ol>
    </nav>

    <div class="page-head">
        <Brick Color="var(--brick-blue)" Studs="3" Width="54" />
        <h1>@list.Name</h1>
    </div>

    @if (list.Sets.Count == 0)
    {
        <div class="empty">
            <Brick Color="var(--brick-yellow)" Studs="2" Width="48" />
            <span>No sets in this list yet. Add one below by its set number.</span>
        </div>
    }
    else
    {
        <div class="set-grid">
            @foreach (var set in list.Sets)
            {
                <article class="set-card">
                    <div class="photo">
                        <span class="set-number">#@set.SetNumber</span>
                        <span class="qty" title="Quantity">×@set.Quantity</span>
                        @if (set.ImageUrl is not null)
                        {
                            <a href="@set.ImageUrl" target="_blank" rel="noopener" title="Open full-size picture">
                                <img src="@set.ImageUrl" alt="@set.Name" loading="lazy" />
                            </a>
                        }
                        else
                        {
                            <div class="no-photo">
                                <Brick Color="#c9cfdd" Studs="4" Width="120" />
                                <span>No picture</span>
                            </div>
                        }
                    </div>

                    <div class="body">
                        @if (editingSetId == set.Id)
                        {
                            <div class="edit-form">
                                <div>
                                    <label>Set #</label>
                                    <input class="form-control form-control-sm" @bind="editSetNumber" />
                                </div>
                                <div>
                                    <label>Name</label>
                                    <input class="form-control form-control-sm" @bind="editName" />
                                </div>
                                <div>
                                    <label>Theme</label>
                                    <input class="form-control form-control-sm" @bind="editTheme" />
                                </div>
                                <div>
                                    <label>Quantity</label>
                                    <input class="form-control form-control-sm" type="number" min="1" @bind="editQuantity" style="width:90px" />
                                </div>
                            </div>
                            <div class="actions">
                                <button class="btn btn-sm btn-success" @onclick="SaveEdit">Save</button>
                                <button class="btn btn-sm btn-secondary" @onclick="CancelEdit">Cancel</button>
                            </div>
                        }
                        else
                        {
                            <h3>@(string.IsNullOrEmpty(set.Name) ? $"Set {set.SetNumber}" : set.Name)</h3>
                            <div class="chips">
                                @if (!string.IsNullOrEmpty(set.Theme))
                                {
                                    <span class="chip theme">@set.Theme</span>
                                }
                                @if (set.PieceCount is not null)
                                {
                                    <span class="chip">@set.PieceCount.Value.ToString("N0") pieces</span>
                                }
                            </div>
                            <div class="actions">
                                <button class="btn btn-sm btn-warning" @onclick="() => StartEdit(set)">Edit</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteSet(set.Id)">Delete</button>
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    }

    <section class="add-panel">
        <h3>Add a set</h3>
        <div class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label">Set #</label>
                <input class="form-control" @bind="newSetNumber" placeholder="e.g. 75192" disabled="@isAdding" />
            </div>
            <div class="col-auto">
                <label class="form-label">Qty</label>
                <input class="form-control" type="number" min="1" @bind="newQuantity" style="width:80px" disabled="@isAdding" />
            </div>
            <div class="col-auto">
                <button class="btn btn-light" @onclick="AddSet" disabled="@isAdding">
                    @if (isAdding) { <span class="spinner-border spinner-border-sm me-1" role="status"></span> <span>Fetching...</span> }
                    else { <span>Add set</span> }
                </button>
            </div>
        </div>
        <p class="hint">Name, theme, picture, and piece count come from Rebrickable automatically.</p>
    </section>

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger mt-3">@errorMessage</div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private SetListDto? list;
    private string? errorMessage;

    // Add form
    private string newSetNumber = string.Empty;
    private int newQuantity = 1;
    private bool isAdding = false;

    // Edit state
    private int? editingSetId;
    private string editSetNumber = string.Empty;
    private string editTheme = string.Empty;
    private string editName = string.Empty;
    private int editQuantity = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadList();
    }

    private async Task LoadList()
    {
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            list = await http.GetFromJsonAsync<SetListDto>($"api/lists/{Id}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load list: {ex.Message}";
        }
    }

    private async Task AddSet()
    {
        if (string.IsNullOrWhiteSpace(newSetNumber)) return;
        isAdding = true;
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            var response = await http.PostAsJsonAsync($"api/lists/{Id}/sets", new
            {
                SetNumber = newSetNumber,
                Quantity = newQuantity
            });
            if (response.IsSuccessStatusCode)
            {
                newSetNumber = string.Empty;
                newQuantity = 1;
                errorMessage = null;
                await LoadList();
            }
            else
            {
                errorMessage = $"Failed to add set: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isAdding = false;
        }
    }

    private void StartEdit(LegoSetDto set)
    {
        editingSetId = set.Id;
        editSetNumber = set.SetNumber;
        editTheme = set.Theme;
        editName = set.Name;
        editQuantity = set.Quantity;
    }

    private void CancelEdit() => editingSetId = null;

    private async Task SaveEdit()
    {
        if (editingSetId is null) return;
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            var response = await http.PutAsJsonAsync($"api/lists/{Id}/sets/{editingSetId}", new
            {
                SetNumber = editSetNumber,
                Theme = editTheme,
                Name = editName,
                Quantity = editQuantity
            });
            if (response.IsSuccessStatusCode)
            {
                editingSetId = null;
                errorMessage = null;
                await LoadList();
            }
            else
            {
                errorMessage = $"Failed to update set: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private async Task DeleteSet(int setId)
    {
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            await http.DeleteAsync($"api/lists/{Id}/sets/{setId}");
            await LoadList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }
}
