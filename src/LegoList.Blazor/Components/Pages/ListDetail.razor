@page "/lists/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@using LegoList.Blazor.Models
@using LegoList.Blazor.Services

<PageTitle>@(list?.Name ?? "List")</PageTitle>

@if (list is null && errorMessage is not null)
{
    <a class="back-link" href="/">‹ All lists</a>
    <div class="notice" role="alert">@errorMessage</div>
}
else if (list is null)
{
    <p class="page-head__summary">Loading this list…</p>
}
else
{
    <div class="page-head">
        <a class="back-link" href="/">‹ All lists</a>
        <h1>@list.Name</h1>
        @if (list.Sets.Count > 0)
        {
            <p class="page-head__summary">@Summary()</p>
        }
    </div>

    <div class="add-bar">
        <h2 class="add-bar__title">Add a set</h2>
        <label class="lb-field lb-field--number">
            Set number
            <input class="lb-input" @bind="newSetNumber" placeholder="e.g. 75192" disabled="@isAdding" />
        </label>
        <label class="lb-field">
            Quantity
            <input class="lb-input lb-input--qty" type="number" min="1" @bind="newQuantity" disabled="@isAdding" />
        </label>
        <button class="lb-btn lb-btn--green" @onclick="AddSet" disabled="@isAdding">
            @if (isAdding) { <span class="spinner" role="status"></span> <span>Looking up set…</span> }
            else { <span>Add set</span> }
        </button>
    </div>
    <p class="add-hint">The name, theme, picture, and piece count come from Rebrickable.</p>

    <details class="bulk-add" open="@(isBulkAdding || bulkText.Length > 0)">
        <summary>Add several sets at once</summary>
        <label class="lb-field">
            One set per line: a set number, then an optional quantity (e.g. <code>75192</code> or <code>10294 x2</code>).
            <textarea class="lb-input" rows="6" placeholder="75192&#10;10294 x2&#10;42083"
                      @bind="bulkText" @bind:event="oninput" disabled="@isBulkAdding"></textarea>
        </label>
        <div class="bulk-add__actions">
            <button class="lb-btn lb-btn--green" @onclick="AddMany" disabled="@(isBulkAdding || string.IsNullOrWhiteSpace(bulkText))">
                @if (isBulkAdding) { <span class="spinner" role="status"></span> <span>@bulkProgress</span> }
                else { <span>Add these sets</span> }
            </button>
            <span class="add-hint">Sets are looked up one at a time to stay under Rebrickable's rate limit, so a long list takes a little while.</span>
        </div>
    </details>

    var missingCount = MissingDetails().Count;
    @if (missingCount > 0 || isBulkLooking)
    {
        <div class="lookup-bar">
            @if (isBulkLooking)
            {
                <span class="spinner spinner--dark" role="status"></span>
                <span>@bulkLookupProgress</span>
                <button class="lb-btn lb-btn--small lb-btn--red" @onclick="CancelLookUpMissing">Cancel</button>
            }
            else
            {
                <button class="lb-btn" disabled="@(refreshingSetId is not null)" @onclick="LookUpMissing">
                    Look up missing details (@missingCount)
                </button>
                <span class="add-hint">Fetches the name, theme, picture and piece count from Rebrickable.</span>
            }
        </div>
    }

    @if (infoMessage is not null)
    {
        <div class="notice mb-4" role="status">@infoMessage</div>
    }

    @if (errorMessage is not null)
    {
        <div class="notice mb-4" role="alert">@errorMessage</div>
    }

    @if (list.Sets.Count == 0)
    {
        <div class="empty">
            <strong>This list is empty.</strong>
            Add your first set with its set number above.
        </div>
    }
    else
    {
        var themes = SetGrouping.Themes(list.Sets, s => s.Theme);
        @if (themes.Count > 1)
        {
            <div class="theme-filter" role="group" aria-label="Filter by theme">
                <span class="theme-filter__label">Themes:</span>
                @foreach (var (theme, count) in themes)
                {
                    var chosen = themeFilter.Contains(theme);
                    <button type="button" class="theme-chip@(chosen ? " theme-chip--on" : "")" aria-pressed="@(chosen ? "true" : "false")"
                            @onclick="() => ToggleTheme(theme)">@theme <span class="theme-chip__count">@count</span></button>
                }
                @if (themeFilter.Count > 0)
                {
                    <button type="button" class="lb-btn lb-btn--small" @onclick="ClearThemeFilter">Show all themes</button>
                }
            </div>
        }
        var groups = SetGrouping.Group(list.Sets, s => s.Theme, s => s.SetNumber, themeFilter);
        @if (groups.Count == 0)
        {
            <div class="empty">
                <strong>No sets in the chosen themes.</strong>
                They may have been moved or deleted. Use “Show all themes” to see everything.
            </div>
        }
        @foreach (var group in groups)
        {
        <section class="theme-group" aria-labelledby="theme-@GroupAnchor(group.Theme)">
        <h2 class="theme-group__title" id="theme-@GroupAnchor(group.Theme)">@group.Theme <span class="theme-group__count">@group.Sets.Count</span></h2>
        <div class="set-grid">
            @foreach (var set in group.Sets)
            {
                @if (editingSetId == set.Id)
                {
                    <article class="set-card set-card--editing">
                        <div class="set-card__body">
                            <label class="lb-field">
                                Set number
                                <input class="lb-input" @bind="editSetNumber" />
                            </label>
                            <label class="lb-field">
                                Theme
                                <input class="lb-input" @bind="editTheme" />
                            </label>
                            <label class="lb-field">
                                Name
                                <input class="lb-input" @bind="editName" />
                            </label>
                            <label class="lb-field">
                                Quantity
                                <input class="lb-input lb-input--qty" type="number" min="1" @bind="editQuantity" />
                            </label>
                            <div class="set-card__actions">
                                <button class="lb-btn lb-btn--small lb-btn--blue" @onclick="SaveEdit">Save changes</button>
                                <button class="lb-btn lb-btn--small lb-btn--red" @onclick="CancelEdit">Cancel</button>
                            </div>
                        </div>
                    </article>
                }
                else
                {
                    <article class="set-card">
                        <div class="set-card__picture">
                            @if (SetImage.TryGetSafeHttpUrl(set.ImageUrl, out var imageUrl))
                            {
                                <button type="button" class="set-card__zoom" title="Enlarge picture"
                                        aria-label="Enlarge picture of @SetImage.GetAlt(set)"
                                        @onclick="() => OpenImage(imageUrl, SetImage.GetAlt(set))">
                                    <img src="@imageUrl" alt="@SetImage.GetAlt(set)" loading="lazy" />
                                </button>
                            }
                            else
                            {
                                <span>No picture</span>
                            }
                            <span class="set-card__number">@set.SetNumber</span>
                            @if (set.Quantity != 1)
                            {
                                <span class="set-card__qty" title="Quantity">×@set.Quantity</span>
                            }
                        </div>
                        <div class="set-card__body">
                            <span class="set-card__theme">@set.Theme</span>
                            <h2 class="set-card__name">@set.Name</h2>
                            @if (set.PieceCount is int pieces)
                            {
                                <span class="set-card__pieces">@pieces.ToString("N0") pieces</span>
                            }
                            @if (set.Built || !string.IsNullOrWhiteSpace(set.DisplayLocation))
                            {
                                <div class="set-card__badges">
                                    @if (set.Built)
                                    {
                                        <span class="badge badge--built">Built</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(set.DisplayLocation))
                                    {
                                        <span class="badge" title="Display location">@set.DisplayLocation</span>
                                    }
                                </div>
                            }
                            <div class="set-card__actions">
                                @if (movingSetId == set.Id)
                                {
                                    @if (otherLists is null)
                                    {
                                        <span class="add-hint">Loading your lists…</span>
                                    }
                                    else if (otherLists.Count == 0)
                                    {
                                        <span class="add-hint">You have no other lists yet. Create one on the lists page first.</span>
                                        <button class="lb-btn lb-btn--small" @onclick="CancelMove">Close</button>
                                    }
                                    else
                                    {
                                        <label class="lb-field set-card__move">
                                            Move to
                                            <select class="lb-input" @bind="moveTargetId">
                                                <option value="0">Choose a list…</option>
                                                @foreach (var other in otherLists)
                                                {
                                                    <option value="@other.Id">@other.Name</option>
                                                }
                                            </select>
                                        </label>
                                        <button class="lb-btn lb-btn--small lb-btn--blue" disabled="@(moveTargetId == 0 || isMoving)" @onclick="MoveSet">
                                            @(isMoving ? "Moving…" : "Move")
                                        </button>
                                        <button class="lb-btn lb-btn--small lb-btn--red" disabled="@isMoving" @onclick="CancelMove">Cancel</button>
                                    }
                                }
                                else
                                {
                                    @if (set.ImageUrl is null)
                                    {
                                        <button class="lb-btn lb-btn--small" aria-label="Look up details for @set.SetNumber" title="Fetch the name, theme, picture and piece count from Rebrickable"
                                                disabled="@(refreshingSetId == set.Id || isBulkLooking)" @onclick="() => RefreshSet(set.Id)">
                                            @(refreshingSetId == set.Id ? "Looking up…" : "Look up details")
                                        </button>
                                    }
                                    <a class="lb-btn lb-btn--small lb-btn--blue" href="/lists/@Id/sets/@set.Id" aria-label="Details for @(string.IsNullOrWhiteSpace(set.Name) ? set.SetNumber : set.Name)">Details</a>
                                    <button class="lb-btn lb-btn--small lb-btn--blue" aria-label="Edit @set.Name" @onclick="() => StartEdit(set)">Edit</button>
                                    <button class="lb-btn lb-btn--small lb-btn--danger" aria-label="Delete @set.Name" @onclick="() => DeleteSet(set.Id)">Delete</button>
                                    <button class="lb-btn lb-btn--small lb-btn--ink" aria-label="Move @set.Name to another list" @onclick="() => StartMove(set)">Move</button>
                                }
                            </div>
                        </div>
                    </article>
                }
            }
        </div>
        </section>
        }
    }

    <ImageLightbox Url="@lightboxUrl" Alt="@lightboxAlt" OnClose="CloseImage" />
}

@code {
    [Parameter] public int Id { get; set; }

    private SetListDto? list;
    private string? errorMessage;

    // Add form
    private string newSetNumber = string.Empty;
    private int newQuantity = 1;
    private bool isAdding = false;
    private string? infoMessage;

    // Bulk add state
    private string bulkText = string.Empty;
    private bool isBulkAdding;
    private string? bulkProgress;

    // Move state
    private int? movingSetId;
    private int moveTargetId;
    private bool isMoving;
    private List<SetListDto>? otherLists;

    // Refresh state
    private int? refreshingSetId;

    // Bulk "look up missing details" state
    private bool isBulkLooking;
    private string? bulkLookupProgress;
    private CancellationTokenSource? lookupCts;
    // Sets Rebrickable has no record of: don't count them as "missing" again or queue them every run.
    private readonly HashSet<int> notFoundSetIds = [];
    private bool disposed;

    // Themes the view is limited to (empty = show every theme)
    private readonly HashSet<string> themeFilter = new(StringComparer.OrdinalIgnoreCase);

    // Picture viewer state
    private string? lightboxUrl;
    private string? lightboxAlt;

    // Edit state
    private int? editingSetId;
    private string editSetNumber = string.Empty;
    private string editTheme = string.Empty;
    private string editName = string.Empty;
    private int editQuantity = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadList();
    }

    private void ToggleTheme(string theme)
    {
        if (!themeFilter.Remove(theme)) themeFilter.Add(theme);
    }

    private void ClearThemeFilter() => themeFilter.Clear();

    private static string GroupAnchor(string theme) =>
        System.Text.RegularExpressions.Regex.Replace(theme.ToLowerInvariant(), "[^a-z0-9]+", "-").Trim('-');

    private string Summary()
    {
        var sets = list!.Sets.Sum(s => s.Quantity);
        var pieces = list.Sets.Sum(s => (s.PieceCount ?? 0) * s.Quantity);
        var text = sets == 1 ? "1 set" : $"{sets:N0} sets";
        return pieces > 0 ? $"{text}, {pieces:N0} pieces in all." : $"{text}.";
    }

    private async Task LoadList()
    {
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            list = await http.GetFromJsonAsync<SetListDto>($"api/lists/{Id}");
            if (list is not null)
            {
                var present = SetGrouping.Themes(list.Sets, s => s.Theme).Select(t => t.Theme).ToHashSet(StringComparer.OrdinalIgnoreCase);
                themeFilter.RemoveWhere(t => !present.Contains(t));
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load list: {ex.Message}";
        }
    }

    private async Task AddSet()
    {
        if (string.IsNullOrWhiteSpace(newSetNumber)) return;
        isAdding = true;
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            var response = await http.PostAsJsonAsync($"api/lists/{Id}/sets", new
            {
                SetNumber = newSetNumber,
                Quantity = newQuantity
            });
            if (response.IsSuccessStatusCode)
            {
                var created = await response.Content.ReadFromJsonAsync<LegoSetDto>();
                newSetNumber = string.Empty;
                newQuantity = 1;
                errorMessage = null;
                infoMessage = created?.LookupFailed == true
                    ? "Set added, but Rebrickable couldn't be reached for its details (it may be rate limiting). Use “Look up details” on the set in a minute."
                    : null;
                await LoadList();
            }
            else
            {
                errorMessage = $"Failed to add set: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isAdding = false;
        }
    }

    private async Task AddMany()
    {
        var parsed = BulkSetParser.Parse(bulkText);
        if (parsed.Entries.Count == 0 && parsed.Invalid.Count == 0) return;

        isBulkAdding = true;
        errorMessage = null;
        infoMessage = null;
        var added = 0;
        var withoutDetails = 0;
        var failed = new List<BulkSetEntry>();
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            for (var i = 0; i < parsed.Entries.Count; i++)
            {
                var entry = parsed.Entries[i];
                bulkProgress = $"Adding {i + 1} of {parsed.Entries.Count} ({entry.SetNumber})…";
                StateHasChanged();
                try
                {
                    var response = await http.PostAsJsonAsync($"api/lists/{Id}/sets", new
                    {
                        SetNumber = entry.SetNumber,
                        Quantity = entry.Quantity
                    });
                    if (response.IsSuccessStatusCode)
                    {
                        added++;
                        var created = await response.Content.ReadFromJsonAsync<LegoSetDto>();
                        if (created?.LookupFailed == true) withoutDetails++;
                    }
                    else
                    {
                        failed.Add(entry);
                    }
                }
                catch (Exception)
                {
                    failed.Add(entry);
                }
            }
        }
        finally
        {
            isBulkAdding = false;
            bulkProgress = null;
        }

        // Leave only what still needs attention in the box, so it can be fixed and retried.
        bulkText = string.Join("\n",
            failed.Select(f => f.Quantity == 1 ? f.SetNumber : $"{f.SetNumber} x{f.Quantity}")
                .Concat(parsed.Invalid));

        var parts = new List<string> { added == 1 ? "Added 1 set." : $"Added {added} sets." };
        if (withoutDetails > 0)
            parts.Add($"{withoutDetails} couldn't get details from Rebrickable yet; use “Look up details” on them in a minute.");
        if (failed.Count > 0)
            parts.Add($"{failed.Count} failed to add and {(failed.Count == 1 ? "is" : "are")} still in the box.");
        if (parsed.Invalid.Count > 0)
            parts.Add($"Couldn't understand: {string.Join(", ", parsed.Invalid)}.");
        infoMessage = string.Join(" ", parts);

        await LoadList();
    }

    private async Task StartMove(LegoSetDto set)
    {
        movingSetId = set.Id;
        moveTargetId = 0;
        otherLists = null;
        errorMessage = null;
        infoMessage = null;
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            var all = await http.GetFromJsonAsync<List<SetListDto>>("api/lists") ?? [];
            // Ignore a stale answer if the user already closed or switched the picker.
            if (movingSetId == set.Id)
                otherLists = all.Where(l => l.Id != Id).ToList();
        }
        catch (Exception ex)
        {
            movingSetId = null;
            errorMessage = $"Failed to load your lists: {ex.Message}";
        }
    }

    private void CancelMove()
    {
        movingSetId = null;
        otherLists = null;
    }

    private async Task MoveSet()
    {
        if (movingSetId is not int setId || moveTargetId == 0) return;
        isMoving = true;
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            var response = await http.PostAsJsonAsync($"api/lists/{Id}/sets/{setId}/move", new { TargetListId = moveTargetId });
            if (response.IsSuccessStatusCode)
            {
                var moved = await response.Content.ReadFromJsonAsync<LegoSetDto>();
                var name = list?.Sets.FirstOrDefault(s => s.Id == setId)?.Name;
                infoMessage = $"Moved {(string.IsNullOrWhiteSpace(name) ? "the set" : $"“{name}”")} to “{moved?.TargetListName}”."
                    + (moved?.CombinedWithExisting == true ? " It was already there, so the quantities were added together." : "");
                errorMessage = null;
                CancelMove();
                await LoadList();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                errorMessage = "That set or list no longer exists. Reload the page and try again.";
            }
            else
            {
                errorMessage = $"Failed to move set: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isMoving = false;
        }
    }

    private void OpenImage(string url, string alt)
    {
        lightboxUrl = url;
        lightboxAlt = alt;
    }

    private void CloseImage() => lightboxUrl = null;

    private async Task RefreshSet(int setId)
    {
        refreshingSetId = setId;
        errorMessage = null;
        infoMessage = null;
        try
        {
            var outcome = await RefreshOne(setId, CancellationToken.None);
            var setNumber = list?.Sets.FirstOrDefault(s => s.Id == setId)?.SetNumber;
            if (outcome == LookupOutcome.NotFound)
                infoMessage = $"Rebrickable has no record of set {setNumber}. You can still edit its name and theme yourself.";
            else if (outcome == LookupOutcome.Failed)
                errorMessage = "Rebrickable couldn't be reached right now (it may be rate limiting). Try again in a minute.";
        }
        finally
        {
            refreshingSetId = null;
        }
    }

    /// <summary>
    /// Asks the API to look one set up on Rebrickable and, on success, updates the set on screen in place
    /// (so a long bulk run doesn't reload the whole list for every set).
    /// </summary>
    private async Task<LookupOutcome> RefreshOne(int setId, CancellationToken cancellationToken)
    {
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            var response = await http.PostAsync($"api/lists/{Id}/sets/{setId}/refresh", content: null, cancellationToken);
            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                // The set was deleted or moved meanwhile; nothing to look up.
                return LookupOutcome.NotFound;
            }
            if (!response.IsSuccessStatusCode)
                return LookupOutcome.Failed;

            var refreshed = await response.Content.ReadFromJsonAsync<LegoSetDto>(cancellationToken);
            var set = list?.Sets.FirstOrDefault(s => s.Id == setId);
            if (set is not null && refreshed is not null)
            {
                set.Name = refreshed.Name;
                set.Theme = refreshed.Theme;
                set.ImageUrl = refreshed.ImageUrl;
                set.PieceCount = refreshed.PieceCount;
            }
            if (refreshed?.Found == false)
            {
                notFoundSetIds.Add(setId);
                return LookupOutcome.NotFound;
            }
            notFoundSetIds.Remove(setId);
            return LookupOutcome.Updated;
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception)
        {
            return LookupOutcome.Failed;
        }
    }

    private List<int> MissingDetails() =>
        list?.Sets.Where(s => s.ImageUrl is null && !notFoundSetIds.Contains(s.Id)).Select(s => s.Id).ToList() ?? [];

    private async Task LookUpMissing()
    {
        if (isBulkLooking) return;
        var ids = MissingDetails();
        if (ids.Count == 0) return;

        errorMessage = null;
        infoMessage = null;
        isBulkLooking = true;
        lookupCts = new CancellationTokenSource();
        BulkLookupResult? result = null;
        try
        {
            // The API spaces its Rebrickable calls to stay under the rate limit; the runner just goes one at a time.
            result = await new BulkLookupRunner().RunAsync(
                ids,
                RefreshOne,
                (position, total, setId) =>
                {
                    var number = list?.Sets.FirstOrDefault(s => s.Id == setId)?.SetNumber;
                    bulkLookupProgress = $"Looking up {position} of {total} ({number})…";
                    StateHasChanged();
                },
                lookupCts.Token);
        }
        finally
        {
            lookupCts.Dispose();
            lookupCts = null;
            isBulkLooking = false;
            bulkLookupProgress = null;
        }

        if (disposed || result is null) return;

        var parts = new List<string>();
        parts.Add(result.Updated == 1 ? "Looked up details for 1 set." : $"Looked up details for {result.Updated} sets.");
        if (result.NotFound > 0)
            parts.Add($"{result.NotFound} {(result.NotFound == 1 ? "isn't" : "aren't")} on Rebrickable; you can edit {(result.NotFound == 1 ? "its" : "their")} name and theme yourself.");
        if (result.StoppedByFailures)
            parts.Add($"Stopped with {result.Remaining} still to do because Rebrickable isn't responding (it may be rate limiting). Try again in a minute.");
        else if (result.Cancelled)
            parts.Add($"Cancelled with {result.Remaining} still to do.");
        infoMessage = string.Join(" ", parts);
    }

    private void CancelLookUpMissing() => lookupCts?.Cancel();

    public void Dispose()
    {
        disposed = true;
        lookupCts?.Cancel();
    }

    private void StartEdit(LegoSetDto set)
    {
        editingSetId = set.Id;
        editSetNumber = set.SetNumber;
        editTheme = set.Theme;
        editName = set.Name;
        editQuantity = set.Quantity;
    }

    private void CancelEdit() => editingSetId = null;

    private async Task SaveEdit()
    {
        if (editingSetId is null) return;
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            var response = await http.PutAsJsonAsync($"api/lists/{Id}/sets/{editingSetId}", new
            {
                SetNumber = editSetNumber,
                Theme = editTheme,
                Name = editName,
                Quantity = editQuantity
            });
            if (response.IsSuccessStatusCode)
            {
                editingSetId = null;
                errorMessage = null;
                await LoadList();
            }
            else
            {
                errorMessage = $"Failed to update set: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private async Task DeleteSet(int setId)
    {
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            await http.DeleteAsync($"api/lists/{Id}/sets/{setId}");
            await LoadList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }
}
