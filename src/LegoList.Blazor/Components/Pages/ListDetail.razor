@page "/lists/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@using LegoList.Blazor.Models
@using LegoList.Blazor.Services

<PageTitle>@(list?.Name ?? "List")</PageTitle>

@if (list is null && errorMessage is not null)
{
    <a class="back-link" href="/">‹ All lists</a>
    <div class="notice" role="alert">@errorMessage</div>
}
else if (list is null)
{
    <p class="page-head__summary">Loading this list…</p>
}
else
{
    <div class="page-head">
        <a class="back-link" href="/">‹ All lists</a>
        <h1>@list.Name</h1>
        @if (list.Sets.Count > 0)
        {
            <p class="page-head__summary">@Summary()</p>
        }
    </div>

    <div class="add-bar">
        <h2 class="add-bar__title">Add a set</h2>
        <label class="lb-field lb-field--number">
            Set number
            <input class="lb-input" @bind="newSetNumber" placeholder="e.g. 75192" disabled="@isAdding" />
        </label>
        <label class="lb-field">
            Quantity
            <input class="lb-input lb-input--qty" type="number" min="1" @bind="newQuantity" disabled="@isAdding" />
        </label>
        <button class="lb-btn lb-btn--red" @onclick="AddSet" disabled="@isAdding">
            @if (isAdding) { <span class="spinner" role="status"></span> <span>Looking up set…</span> }
            else { <span>Add set</span> }
        </button>
    </div>
    <p class="add-hint">The name, theme, picture, and piece count come from Rebrickable.</p>

    <details class="bulk-add" open="@(isBulkAdding || bulkText.Length > 0)">
        <summary>Add several sets at once</summary>
        <label class="lb-field">
            One set per line: a set number, then an optional quantity (e.g. <code>75192</code> or <code>10294 x2</code>).
            <textarea class="lb-input" rows="6" placeholder="75192&#10;10294 x2&#10;42083"
                      @bind="bulkText" @bind:event="oninput" disabled="@isBulkAdding"></textarea>
        </label>
        <div class="bulk-add__actions">
            <button class="lb-btn lb-btn--red" @onclick="AddMany" disabled="@(isBulkAdding || string.IsNullOrWhiteSpace(bulkText))">
                @if (isBulkAdding) { <span class="spinner" role="status"></span> <span>@bulkProgress</span> }
                else { <span>Add these sets</span> }
            </button>
            <span class="add-hint">Sets are looked up one at a time to stay under Rebrickable's rate limit, so a long list takes a little while.</span>
        </div>
    </details>

    @if (infoMessage is not null)
    {
        <div class="notice mb-4" role="status">@infoMessage</div>
    }

    @if (errorMessage is not null)
    {
        <div class="notice mb-4" role="alert">@errorMessage</div>
    }

    @if (list.Sets.Count == 0)
    {
        <div class="empty">
            <strong>This list is empty.</strong>
            Add your first set with its set number above.
        </div>
    }
    else
    {
        <div class="set-grid">
            @foreach (var set in list.Sets)
            {
                @if (editingSetId == set.Id)
                {
                    <article class="set-card set-card--editing">
                        <div class="set-card__body">
                            <label class="lb-field">
                                Set number
                                <input class="lb-input" @bind="editSetNumber" />
                            </label>
                            <label class="lb-field">
                                Theme
                                <input class="lb-input" @bind="editTheme" />
                            </label>
                            <label class="lb-field">
                                Name
                                <input class="lb-input" @bind="editName" />
                            </label>
                            <label class="lb-field">
                                Quantity
                                <input class="lb-input lb-input--qty" type="number" min="1" @bind="editQuantity" />
                            </label>
                            <div class="set-card__actions">
                                <button class="lb-btn lb-btn--small lb-btn--blue" @onclick="SaveEdit">Save changes</button>
                                <button class="lb-btn lb-btn--small" @onclick="CancelEdit">Cancel</button>
                            </div>
                        </div>
                    </article>
                }
                else
                {
                    <article class="set-card">
                        <div class="set-card__picture">
                            @if (TryGetSafeHttpUrl(set.ImageUrl, out var imageUrl))
                            {
                                <a class="set-card__zoom" href="@imageUrl" target="_blank" rel="noopener noreferrer" title="Open full-size picture">
                                    <img src="@imageUrl" alt="@GetSetImageAlt(set)" loading="lazy" />
                                </a>
                            }
                            else
                            {
                                <span>No picture</span>
                            }
                            <span class="set-card__number">@set.SetNumber</span>
                            @if (set.Quantity != 1)
                            {
                                <span class="set-card__qty" title="Quantity">×@set.Quantity</span>
                            }
                        </div>
                        <div class="set-card__body">
                            <span class="set-card__theme">@set.Theme</span>
                            <h2 class="set-card__name">@set.Name</h2>
                            @if (set.PieceCount is int pieces)
                            {
                                <span class="set-card__pieces">@pieces.ToString("N0") pieces</span>
                            }
                            <div class="set-card__actions">
                                @if (set.ImageUrl is null)
                                {
                                    <button class="lb-btn lb-btn--small" aria-label="Look up details for @set.SetNumber" title="Fetch the name, theme, picture and piece count from Rebrickable"
                                            disabled="@(refreshingSetId == set.Id)" @onclick="() => RefreshSet(set.Id)">
                                        @(refreshingSetId == set.Id ? "Looking up…" : "Look up details")
                                    </button>
                                }
                                <button class="lb-btn lb-btn--small lb-btn--blue" aria-label="Edit @set.Name" @onclick="() => StartEdit(set)">Edit</button>
                                <button class="lb-btn lb-btn--small lb-btn--danger" aria-label="Delete @set.Name" @onclick="() => DeleteSet(set.Id)">Delete</button>
                            </div>
                        </div>
                    </article>
                }
            }
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private SetListDto? list;
    private string? errorMessage;

    // Add form
    private string newSetNumber = string.Empty;
    private int newQuantity = 1;
    private bool isAdding = false;
    private string? infoMessage;

    // Bulk add state
    private string bulkText = string.Empty;
    private bool isBulkAdding;
    private string? bulkProgress;

    // Refresh state
    private int? refreshingSetId;

    // Edit state
    private int? editingSetId;
    private string editSetNumber = string.Empty;
    private string editTheme = string.Empty;
    private string editName = string.Empty;
    private int editQuantity = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadList();
    }

    private string Summary()
    {
        var sets = list!.Sets.Sum(s => s.Quantity);
        var pieces = list.Sets.Sum(s => (s.PieceCount ?? 0) * s.Quantity);
        var text = sets == 1 ? "1 set" : $"{sets:N0} sets";
        return pieces > 0 ? $"{text}, {pieces:N0} pieces in all." : $"{text}.";
    }

    private async Task LoadList()
    {
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            list = await http.GetFromJsonAsync<SetListDto>($"api/lists/{Id}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load list: {ex.Message}";
        }
    }

    private async Task AddSet()
    {
        if (string.IsNullOrWhiteSpace(newSetNumber)) return;
        isAdding = true;
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            var response = await http.PostAsJsonAsync($"api/lists/{Id}/sets", new
            {
                SetNumber = newSetNumber,
                Quantity = newQuantity
            });
            if (response.IsSuccessStatusCode)
            {
                var created = await response.Content.ReadFromJsonAsync<LegoSetDto>();
                newSetNumber = string.Empty;
                newQuantity = 1;
                errorMessage = null;
                infoMessage = created?.LookupFailed == true
                    ? "Set added, but Rebrickable couldn't be reached for its details (it may be rate limiting). Use “Look up details” on the set in a minute."
                    : null;
                await LoadList();
            }
            else
            {
                errorMessage = $"Failed to add set: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isAdding = false;
        }
    }

    private async Task AddMany()
    {
        var parsed = BulkSetParser.Parse(bulkText);
        if (parsed.Entries.Count == 0 && parsed.Invalid.Count == 0) return;

        isBulkAdding = true;
        errorMessage = null;
        infoMessage = null;
        var added = 0;
        var withoutDetails = 0;
        var failed = new List<BulkSetEntry>();
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            for (var i = 0; i < parsed.Entries.Count; i++)
            {
                var entry = parsed.Entries[i];
                bulkProgress = $"Adding {i + 1} of {parsed.Entries.Count} ({entry.SetNumber})…";
                StateHasChanged();
                try
                {
                    var response = await http.PostAsJsonAsync($"api/lists/{Id}/sets", new
                    {
                        SetNumber = entry.SetNumber,
                        Quantity = entry.Quantity
                    });
                    if (response.IsSuccessStatusCode)
                    {
                        added++;
                        var created = await response.Content.ReadFromJsonAsync<LegoSetDto>();
                        if (created?.LookupFailed == true) withoutDetails++;
                    }
                    else
                    {
                        failed.Add(entry);
                    }
                }
                catch (Exception)
                {
                    failed.Add(entry);
                }
            }
        }
        finally
        {
            isBulkAdding = false;
            bulkProgress = null;
        }

        // Leave only what still needs attention in the box, so it can be fixed and retried.
        bulkText = string.Join("\n",
            failed.Select(f => f.Quantity == 1 ? f.SetNumber : $"{f.SetNumber} x{f.Quantity}")
                .Concat(parsed.Invalid));

        var parts = new List<string> { added == 1 ? "Added 1 set." : $"Added {added} sets." };
        if (withoutDetails > 0)
            parts.Add($"{withoutDetails} couldn't get details from Rebrickable yet; use “Look up details” on them in a minute.");
        if (failed.Count > 0)
            parts.Add($"{failed.Count} failed to add and {(failed.Count == 1 ? "is" : "are")} still in the box.");
        if (parsed.Invalid.Count > 0)
            parts.Add($"Couldn't understand: {string.Join(", ", parsed.Invalid)}.");
        infoMessage = string.Join(" ", parts);

        await LoadList();
    }

    private async Task RefreshSet(int setId)
    {
        refreshingSetId = setId;
        errorMessage = null;
        infoMessage = null;
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            var response = await http.PostAsync($"api/lists/{Id}/sets/{setId}/refresh", content: null);
            if (response.IsSuccessStatusCode)
            {
                var refreshed = await response.Content.ReadFromJsonAsync<LegoSetDto>();
                if (refreshed?.Found == false)
                    infoMessage = $"Rebrickable has no record of set {refreshed.SetNumber}. You can still edit its name and theme yourself.";
                await LoadList();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.ServiceUnavailable)
            {
                errorMessage = "Rebrickable couldn't be reached right now (it may be rate limiting). Try again in a minute.";
            }
            else
            {
                errorMessage = $"Failed to look up details: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            refreshingSetId = null;
        }
    }

    private void StartEdit(LegoSetDto set)
    {
        editingSetId = set.Id;
        editSetNumber = set.SetNumber;
        editTheme = set.Theme;
        editName = set.Name;
        editQuantity = set.Quantity;
    }

    private void CancelEdit() => editingSetId = null;

    private async Task SaveEdit()
    {
        if (editingSetId is null) return;
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            var response = await http.PutAsJsonAsync($"api/lists/{Id}/sets/{editingSetId}", new
            {
                SetNumber = editSetNumber,
                Theme = editTheme,
                Name = editName,
                Quantity = editQuantity
            });
            if (response.IsSuccessStatusCode)
            {
                editingSetId = null;
                errorMessage = null;
                await LoadList();
            }
            else
            {
                errorMessage = $"Failed to update set: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private async Task DeleteSet(int setId)
    {
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            await http.DeleteAsync($"api/lists/{Id}/sets/{setId}");
            await LoadList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private static bool TryGetSafeHttpUrl(string? value, out string safeUrl)
    {
        safeUrl = string.Empty;
        if (string.IsNullOrWhiteSpace(value))
            return false;

        if (!Uri.TryCreate(value, UriKind.Absolute, out var uri))
            return false;

        if (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps)
            return false;

        safeUrl = uri.ToString();
        return true;
    }

    private static string GetSetImageAlt(LegoSetDto set)
    {
        if (!string.IsNullOrWhiteSpace(set.Name))
            return set.Name;

        if (!string.IsNullOrWhiteSpace(set.SetNumber))
            return $"Image of LEGO set {set.SetNumber}";

        return "LEGO set image";
    }
}
