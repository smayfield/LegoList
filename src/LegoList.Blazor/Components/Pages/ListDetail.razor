@page "/lists/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@using LegoList.Blazor.Models

<PageTitle>@(list?.Name ?? "List")</PageTitle>

@if (list is null && errorMessage is not null)
{
    <a class="back-link" href="/">‹ All lists</a>
    <div class="notice" role="alert">@errorMessage</div>
}
else if (list is null)
{
    <p class="page-head__summary">Loading this list…</p>
}
else
{
    <div class="page-head">
        <a class="back-link" href="/">‹ All lists</a>
        <h1>@list.Name</h1>
        @if (list.Sets.Count > 0)
        {
            <p class="page-head__summary">@Summary()</p>
        }
    </div>

    <div class="add-bar">
        <h2 class="add-bar__title">Add a set</h2>
        <label class="lb-field lb-field--number">
            Set number
            <input class="lb-input" @bind="newSetNumber" placeholder="e.g. 75192" disabled="@isAdding" />
        </label>
        <label class="lb-field">
            Quantity
            <input class="lb-input lb-input--qty" type="number" min="1" @bind="newQuantity" disabled="@isAdding" />
        </label>
        <button class="lb-btn lb-btn--red" @onclick="AddSet" disabled="@isAdding">
            @if (isAdding) { <span class="spinner" role="status"></span> <span>Looking up set…</span> }
            else { <span>Add set</span> }
        </button>
    </div>
    <p class="add-hint">The name, theme, picture, and piece count come from Rebrickable.</p>

    @if (errorMessage is not null)
    {
        <div class="notice mb-4" role="alert">@errorMessage</div>
    }

    @if (list.Sets.Count == 0)
    {
        <div class="empty">
            <strong>This list is empty.</strong>
            Add your first set with its set number above.
        </div>
    }
    else
    {
        <div class="set-grid">
            @foreach (var set in list.Sets)
            {
                @if (editingSetId == set.Id)
                {
                    <article class="set-card set-card--editing">
                        <div class="set-card__body">
                            <label class="lb-field">
                                Set number
                                <input class="lb-input" @bind="editSetNumber" />
                            </label>
                            <label class="lb-field">
                                Theme
                                <input class="lb-input" @bind="editTheme" />
                            </label>
                            <label class="lb-field">
                                Name
                                <input class="lb-input" @bind="editName" />
                            </label>
                            <label class="lb-field">
                                Quantity
                                <input class="lb-input lb-input--qty" type="number" min="1" @bind="editQuantity" />
                            </label>
                            <div class="set-card__actions">
                                <button class="lb-btn lb-btn--small lb-btn--blue" @onclick="SaveEdit">Save changes</button>
                                <button class="lb-btn lb-btn--small" @onclick="CancelEdit">Cancel</button>
                            </div>
                        </div>
                    </article>
                }
                else
                {
                    <article class="set-card">
                        <div class="set-card__picture">
                            @if (TryGetSafeHttpUrl(set.ImageUrl, out var imageUrl))
                            {
                                <a class="set-card__zoom" href="@imageUrl" target="_blank" rel="noopener noreferrer" title="Open full-size picture">
                                    <img src="@imageUrl" alt="@GetSetImageAlt(set)" loading="lazy" />
                                </a>
                            }
                            else
                            {
                                <span>No picture</span>
                            }
                            <span class="set-card__number">@set.SetNumber</span>
                            @if (set.Quantity != 1)
                            {
                                <span class="set-card__qty" title="Quantity">×@set.Quantity</span>
                            }
                        </div>
                        <div class="set-card__body">
                            <span class="set-card__theme">@set.Theme</span>
                            <h2 class="set-card__name">@set.Name</h2>
                            @if (set.PieceCount is int pieces)
                            {
                                <span class="set-card__pieces">@pieces.ToString("N0") pieces</span>
                            }
                            <div class="set-card__actions">
                                <button class="lb-btn lb-btn--small lb-btn--blue" aria-label="Edit @set.Name" @onclick="() => StartEdit(set)">Edit</button>
                                <button class="lb-btn lb-btn--small lb-btn--danger" aria-label="Delete @set.Name" @onclick="() => DeleteSet(set.Id)">Delete</button>
                            </div>
                        </div>
                    </article>
                }
            }
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private SetListDto? list;
    private string? errorMessage;

    // Add form
    private string newSetNumber = string.Empty;
    private int newQuantity = 1;
    private bool isAdding = false;

    // Edit state
    private int? editingSetId;
    private string editSetNumber = string.Empty;
    private string editTheme = string.Empty;
    private string editName = string.Empty;
    private int editQuantity = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadList();
    }

    private string Summary()
    {
        var sets = list!.Sets.Sum(s => s.Quantity);
        var pieces = list.Sets.Sum(s => (s.PieceCount ?? 0) * s.Quantity);
        var text = sets == 1 ? "1 set" : $"{sets:N0} sets";
        return pieces > 0 ? $"{text}, {pieces:N0} pieces in all." : $"{text}.";
    }

    private async Task LoadList()
    {
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            list = await http.GetFromJsonAsync<SetListDto>($"api/lists/{Id}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load list: {ex.Message}";
        }
    }

    private async Task AddSet()
    {
        if (string.IsNullOrWhiteSpace(newSetNumber)) return;
        isAdding = true;
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            var response = await http.PostAsJsonAsync($"api/lists/{Id}/sets", new
            {
                SetNumber = newSetNumber,
                Quantity = newQuantity
            });
            if (response.IsSuccessStatusCode)
            {
                newSetNumber = string.Empty;
                newQuantity = 1;
                errorMessage = null;
                await LoadList();
            }
            else
            {
                errorMessage = $"Failed to add set: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isAdding = false;
        }
    }

    private void StartEdit(LegoSetDto set)
    {
        editingSetId = set.Id;
        editSetNumber = set.SetNumber;
        editTheme = set.Theme;
        editName = set.Name;
        editQuantity = set.Quantity;
    }

    private void CancelEdit() => editingSetId = null;

    private async Task SaveEdit()
    {
        if (editingSetId is null) return;
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            var response = await http.PutAsJsonAsync($"api/lists/{Id}/sets/{editingSetId}", new
            {
                SetNumber = editSetNumber,
                Theme = editTheme,
                Name = editName,
                Quantity = editQuantity
            });
            if (response.IsSuccessStatusCode)
            {
                editingSetId = null;
                errorMessage = null;
                await LoadList();
            }
            else
            {
                errorMessage = $"Failed to update set: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private async Task DeleteSet(int setId)
    {
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            await http.DeleteAsync($"api/lists/{Id}/sets/{setId}");
            await LoadList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private static bool TryGetSafeHttpUrl(string? value, out string safeUrl)
    {
        safeUrl = string.Empty;
        if (string.IsNullOrWhiteSpace(value))
            return false;

        if (!Uri.TryCreate(value, UriKind.Absolute, out var uri))
            return false;

        if (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps)
            return false;

        safeUrl = uri.ToString();
        return true;
    }

    private static string GetSetImageAlt(LegoSetDto set)
    {
        if (!string.IsNullOrWhiteSpace(set.Name))
            return set.Name;

        if (!string.IsNullOrWhiteSpace(set.SetNumber))
            return $"Image of LEGO set {set.SetNumber}";

        return "LEGO set image";
    }
}
