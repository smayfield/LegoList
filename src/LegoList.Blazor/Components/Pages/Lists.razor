@page "/"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthStateProvider
@using LegoList.Blazor.Models

<PageTitle>My Lego Lists</PageTitle>

<div class="page-head">
    <Brick Color="var(--brick-red)" Studs="3" Width="54" />
    <h1>My Lego Lists</h1>
</div>

@if (signedIn == false)
{
    <section class="welcome">
        <h2>Welcome to LegoList!</h2>
        <p>Keep track of your LEGO sets in lists. Names, themes, pictures, and piece counts fill in
            automatically from Rebrickable.</p>
        <a class="btn btn-light" href="/auth/login" data-enhance-nav="false">Sign in with Google</a>
        <div class="stack" aria-hidden="true">
            <Brick Color="var(--brick-yellow)" Studs="2" Width="70" />
            <Brick Color="var(--brick-blue)" Studs="3" Width="104" />
            <Brick Color="var(--brick-green)" Studs="4" Width="138" />
        </div>
    </section>
}
else if (lists is null && errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (lists is null)
{
    <p>Loading...</p>
}
else
{
    @if (lists.Count == 0)
    {
        <div class="empty">
            <Brick Color="var(--brick-blue)" Studs="2" Width="48" />
            <span>No lists yet. Start one below, like "Collection", "Wishlist", or "Built".</span>
        </div>
    }
    else
    {
        <div class="card-grid">
            @for (var i = 0; i < lists.Count; i++)
            {
                var list = lists[i];
                var color = Brick.Palette[i % Brick.Palette.Length];
                <article class="list-card" style="--c: @color">
                    <a class="stretched" href="/lists/@list.Id" aria-label="Open @list.Name"></a>
                    <Brick Color="@color" Studs="2" Width="40" />
                    <h3>@list.Name</h3>
                    <span class="count">@list.SetCount @(list.SetCount == 1 ? "set" : "sets")</span>
                    <div class="actions">
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteList(list.Id)">Delete</button>
                    </div>
                </article>
            }
        </div>
    }

    <section class="create-panel">
        <h3>Create a new list</h3>
        <label class="visually-hidden" for="new-list-name">List name</label>
        <div class="d-flex gap-2">
            <input id="new-list-name" class="form-control" placeholder="List name" @bind="newListName" />
            <button class="btn btn-primary" @onclick="CreateList">Create</button>
        </div>
    </section>

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger mt-3">@errorMessage</div>
    }
}

@code {
    private List<SetListDto>? lists;
    private string newListName = string.Empty;
    private string? errorMessage;
    private bool? signedIn;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        signedIn = state.User.Identity?.IsAuthenticated == true;
        if (signedIn == true)
            await LoadLists();
    }

    private async Task LoadLists()
    {
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            lists = await http.GetFromJsonAsync<List<SetListDto>>("api/lists");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load lists: {ex.Message}";
        }
    }

    private async Task CreateList()
    {
        if (string.IsNullOrWhiteSpace(newListName)) return;
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            var response = await http.PostAsJsonAsync("api/lists", new { Name = newListName });
            if (response.IsSuccessStatusCode)
            {
                newListName = string.Empty;
                errorMessage = null;
                await LoadLists();
            }
            else
            {
                errorMessage = $"Failed to create list: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private async Task DeleteList(int id)
    {
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            await http.DeleteAsync($"api/lists/{id}");
            await LoadLists();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }
}
