@page "/"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthStateProvider
@using LegoList.Blazor.Models

<PageTitle>My lists</PageTitle>

@if (signedIn == false)
{
    <section class="welcome">
        <div class="welcome__text">
            <h1>Every set you own, sorted into lists.</h1>
            <p>Type in a set number and LegoList fills in the name, theme, picture, and piece count
                from Rebrickable.</p>
            <a class="lb-btn lb-btn--red" href="/auth/login" data-enhance-nav="false">Sign in with Google</a>
        </div>
        <div class="stack" aria-hidden="true">
            <div class="brick brick--c1"></div>
            <div class="brick brick--c2"></div>
            <div class="brick brick--c0"></div>
            <div class="brick brick--c3"></div>
        </div>
    </section>
}
else if (lists is null && errorMessage is not null)
{
    <h1>My lists</h1>
    <div class="notice" role="alert">@errorMessage</div>
}
else if (lists is null)
{
    <h1>My lists</h1>
    <p class="page-head__summary">Loading your lists…</p>
}
else
{
    <div class="page-head">
        <h1>My lists</h1>
        @if (lists.Count == 0)
        {
            <p class="page-head__summary">No lists yet. Name your first one below.</p>
        }
    </div>

    <div class="brick-grid">
        @foreach (var list in lists)
        {
            <div class="brick brick--c@(list.Id % 6)">
                <a class="brick__link" href="/lists/@list.Id">
                    <span class="brick__name">@list.Name</span>
                    <span class="brick__count">@(list.SetCount == 1 ? "1 set" : $"{list.SetCount} sets")</span>
                </a>
                <button class="brick__delete" aria-label="Delete @list.Name" @onclick="() => DeleteList(list.Id)">Delete</button>
            </div>
        }

        <div class="brick-slot">
            <label class="brick-slot__title" for="new-list-name">New list</label>
            <div class="brick-slot__row">
                <input id="new-list-name" class="lb-input" placeholder="e.g. Star Wars" @bind="newListName" />
                <button class="lb-btn lb-btn--red" @onclick="CreateList">Create list</button>
            </div>
        </div>
    </div>

    @if (errorMessage is not null)
    {
        <div class="notice" role="alert">@errorMessage</div>
    }
}

@code {
    private List<SetListDto>? lists;
    private string newListName = string.Empty;
    private string? errorMessage;
    private bool? signedIn;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        signedIn = state.User.Identity?.IsAuthenticated == true;
        if (signedIn == true)
            await LoadLists();
    }

    private async Task LoadLists()
    {
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            lists = await http.GetFromJsonAsync<List<SetListDto>>("api/lists");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load lists: {ex.Message}";
        }
    }

    private async Task CreateList()
    {
        if (string.IsNullOrWhiteSpace(newListName)) return;
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            var response = await http.PostAsJsonAsync("api/lists", new { Name = newListName });
            if (response.IsSuccessStatusCode)
            {
                newListName = string.Empty;
                errorMessage = null;
                await LoadLists();
            }
            else
            {
                errorMessage = $"Failed to create list: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private async Task DeleteList(int id)
    {
        try
        {
            var http = HttpClientFactory.CreateClient("LegoListApi");
            await http.DeleteAsync($"api/lists/{id}");
            await LoadLists();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }
}
