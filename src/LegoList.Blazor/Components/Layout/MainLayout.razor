@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span class="brick-strip" aria-hidden="true"><Brick Color="var(--brick-red)" Width="28" /><Brick Color="var(--brick-yellow)" Width="28" /><Brick Color="var(--brick-blue)" Width="28" /><Brick Color="var(--brick-green)" Width="28" /></span>
            <a href="https://rebrickable.com" target="_blank" rel="noopener">Set data from Rebrickable</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
