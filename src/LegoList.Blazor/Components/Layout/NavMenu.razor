<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href=""><Brick Color="var(--brick-yellow)" Width="30" Class="me-2" /><span>LegoList</span></a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <Brick Color="#fff" Width="20" Class="me-2" /> My Lists
            </NavLink>
        </div>
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3 mt-2">
                    <span class="nav-link text-light small">
                        @context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                    </span>
                </div>
                <div class="nav-item px-3">
                    <a class="nav-link" href="/auth/logout" data-enhance-nav="false">Sign out</a>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <a class="nav-link" href="/auth/login" data-enhance-nav="false">Sign in with Google</a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
